{
  "name": "binary-sentinel",
  "version": "1.1.0",
  "description": "Static PE/ELF/Mach-O triage in pure JS: headers, sections, entropy, imports, imphash, Rich header, overlays, TLS callbacks, packer hints (UPX, ASPack, VMProtect...), suspicious API capabilities mapped to ATT&CK, and hardening (ASLR, NX, CFG, PIE, RELRO, canary). Never executes samples. Zero deps.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "binary-sentinel": "bin/binary-sentinel.js"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "action.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "rules"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "pe",
    "elf",
    "malware-analysis",
    "static-analysis",
    "imphash",
    "entropy",
    "packer",
    "upx",
    "reverse-engineering",
    "triage",
    "dfir",
    "checksec",
    "security",
    "sarif",
    "cli",
    "github-action",
    "macho",
    "authenticode",
    "capa"
  ],
  "author": "Louis Wright <hello@louiswright.co.uk> (https://github.com/MrLouisWright)",
  "license": "MIT",
  "funding": {
    "type": "stripe",
    "url": "https://donate.stripe.com/aFa00lek3cvX4Ds2Fk9EI0b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLouisWright/binary-sentinel.git"
  },
  "bugs": {
    "url": "https://github.com/MrLouisWright/binary-sentinel/issues"
  },
  "homepage": "https://mrlouiswright.github.io/binary-sentinel/",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  }
}
